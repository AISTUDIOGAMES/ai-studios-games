# OWL_AI — copy to .env (never commit .env). Local defaults work without any of these.
LLAMA_URL=http://127.0.0.1:8080
# LLAMA_API_KEY=                    # only if llama-server runs with --api-key
# CF_ACCESS_CLIENT_ID=              # Cloudflare Access service token (tunnel, phase 2)
# CF_ACCESS_CLIENT_SECRET=
# OWL_AI_ALLOWED_ORIGINS=https://yourdomain.com
# OWL_AI_RATE_MAX=15
# OWL_AI_RATE_WINDOW_MS=300000
# OWL_AI_MAX_ACTIVE=2
