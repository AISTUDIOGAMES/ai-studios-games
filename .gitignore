# ============================================
# AI Studios Games - .gitignore
# ============================================

# --- Dependências (NUNCA subir) ---
node_modules/
**/node_modules/
.pnp
.pnp.js

# --- Build local do client (Vite) ---
# ATENÇÃO: public/bomber-idle/ NÃO está aqui de propósito.
# Ele é o build publicado que a Vercel serve, então precisa ficar no Git.
client/dist/
dist/

# --- Backups gerados pelo script de publicação ---
.publish-backup/

# --- Segredos e chaves (CRÍTICO: Solana / ADMIN_KEY) ---
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
# Keypairs / carteiras Solana
id.json
*keypair*.json
*wallet*.json
!public/**/wallet.js
!slither-idle/wallet.js
!src/wallet*.ts

# --- Cloudflare Workers / Wrangler ---
.wrangler/
.mf/

# --- Vercel ---
.vercel/

# --- Solana / Anchor / Rust ---
target/
.anchor/
test-ledger/
**/*.rs.bk

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Cache de ferramentas ---
.vite/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
coverage/
.nyc_output/

# --- Python (testes e2e) ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# --- Arquivos temporários e de sistema ---
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*~

# --- Editores / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# --- Pacotes compactados soltos ---
*.rar
*.zip
*.7z
