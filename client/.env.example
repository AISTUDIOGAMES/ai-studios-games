# Copie para .env.local (nao versionar). Valores de build do Vite.
# Ambiente: dev (DEVTEST local), alpha (teste publicado na Devnet) ou prod (site atual, sem blockchain).
VITE_ENV=alpha
# RPC da Devnet. A build recusa qualquer rede que nao seja a Devnet (conferido pelo genesis hash).
VITE_RPC_URL=https://api.devnet.solana.com
# API do Alpha (Worker). Vazio = nao conecta ao servidor.
VITE_API_URL=
