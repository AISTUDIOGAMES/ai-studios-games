# Modelo do client/.env.local (nao versionar). Valores de build do Vite, formato CHAVE=valor, sem aspas.
# VITE_ENV: dev (DEVTEST local), alpha (teste publicado) ou prod (site atual, sem blockchain).
VITE_ENV=alpha
# RPC da Devnet. A build recusa redes que nao sejam a Devnet (genesis hash do RPC).
VITE_RPC_URL=https://api.devnet.solana.com
# Worker do Alpha. Local (wrangler dev): http://localhost:8787. Publicado: a URL do Worker.
VITE_ALPHA_API_URL=
# Servidor antigo de saque (legado, nao usado pelo Alpha).
VITE_API_URL=
